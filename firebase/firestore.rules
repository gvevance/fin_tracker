rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@users.fintracker.local";
    }

    match /userProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      // Household tracker: any signed-in user can see every expense.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.addedBy is string
        && request.resource.data.addedBy.size() >= 3;

      // Only the household admin account can change or remove expenses.
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.addedBy == resource.data.addedBy;
      allow delete: if isAdmin();
    }

    match /history/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.actor is string
        && request.resource.data.actor.size() >= 3
        && request.resource.data.type in ["added", "modified", "deleted"]
        && request.auth.token.email == request.resource.data.actor + "@users.fintracker.local"
        && (
          request.resource.data.type == "added"
          || isAdmin()
        );
      allow update, delete: if false;
    }
  }
}
