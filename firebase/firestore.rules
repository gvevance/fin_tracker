rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /userProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      // Household tracker: any signed-in user can see every expense.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.addedBy is string
        && request.resource.data.addedBy.size() >= 3;

      // Edit/delete stays with the person who added it for now.
      // Admin edit/delete is a separate upcoming change.
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
